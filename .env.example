# Prefer python3 scripts/setup-local.py to generate independent secrets.
# Existing bootstrap DB passwords are not changed by editing this file.
COMPOSE_PROJECT_NAME=locatarius-local
POSTGRES_PASSWORD=
MIGRATION_DB_PASSWORD=
RUNTIME_DB_PASSWORD=
SeedAdmin__Email=admin@example.test
SeedAdmin__Password=
SeedAdmin__FirstName=Local
SeedAdmin__LastName=Admin
SeedDemoData__Enabled=false
SeedDemoData__Password=
HTTP_PORT=80
HTTPS_PORT=443
POSTGRES_PORT=5432
# Check host routes/Docker networks before use. nginx IP must be inside this subnet.
DOCKER_SUBNET=172.28.0.0/24
NGINX_IP=172.28.0.10
